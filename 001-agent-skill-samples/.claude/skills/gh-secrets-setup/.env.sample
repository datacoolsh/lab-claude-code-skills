# ========================================
# GitHub Actions Secrets 配置文件
# 复制此文件为 .env 并填写实际值
# ========================================

# --- GitHub 配置 (可选) ---
# 目标仓库，格式: owner/repo
# 留空则使用当前目录的 git 仓库
GITHUB_REPO=

# --- 服务器配置 ---
SERVER_HOST=your-server.example.com
SERVER_USER=deploy
SERVER_SSH_KEY=~/.ssh/id_rsa
SERVER_PORT=22

# --- 应用配置 ---
APP_NAME=myapp
APP_PORT=8000

# --- 数据库配置 ---
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# --- Docker 配置 (可选) ---
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_NAME=