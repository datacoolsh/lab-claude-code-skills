# SMTP 邮件发送配置
# 复制此文件为 .env 并填入实际值

# SMTP 服务器地址
# Gmail: smtp.gmail.com
# Outlook: smtp.office365.com
# QQ邮箱: smtp.qq.com
SMTP_HOST=smtp.gmail.com

# SMTP 端口
# 587: STARTTLS（推荐）
# 465: SSL/TLS
SMTP_PORT=587

# 发件人邮箱地址
SMTP_USER=your_email@gmail.com

# 邮箱密码或应用专用密码
# Gmail: 需要使用应用专用密码（非登录密码）
# 获取地址: https://myaccount.google.com/apppasswords
SMTP_PASS=your_app_password_here

# 连接超时时间（秒）
SMTP_TIMEOUT=30
